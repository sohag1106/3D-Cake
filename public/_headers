# Vite fingerprints every file in /assets, so a given filename never changes
# contents and can be cached indefinitely.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html names the current fingerprint, so it must always be revalidated
# or a returning visitor keeps loading the previous deploy's assets.
/
  Cache-Control: public, max-age=0, must-revalidate
